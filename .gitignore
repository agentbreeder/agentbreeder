docs/superpowers/private/
/website-audit/

# Legacy local artifacts retained during the focused rebuild. These paths no
# longer contain supported source. Preserve the protection formerly supplied
# by their removed nested .gitignore files, including credentials/build output.
/dashboard/
/sidecar/
/examples/go-agent/

# Northwind example: generated secrets, operator state and build output (never commit)
# Local state of an example run in place (never tracked, never packaged).
src/agentbreeder/examples/*/stack/.secrets/
src/agentbreeder/examples/*/.agentbreeder/
src/agentbreeder/examples/*/deploy/
# The examples' former location: state left behind by an older checkout stays ignored.
examples/northwind/stack/.secrets/
examples/northwind/.agentbreeder/
examples/northwind/deploy/
