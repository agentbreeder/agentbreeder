  "GET https://kc.example.com/admin/realms/acme/clients/client-uuid-1": [200, {
    "id": "client-uuid-1", "clientId": "refund-agent", "enabled": true, "serviceAccountsEnabled": true,
    "attributes": {"agentbreeder.kind": "agent"}
  }],
  "GET https://kc.example.com/admin/realms/acme/clients/client-uuid-1/service-account-user": [200, {
    "id": "sa-user-1", "username": "service-account-refund-agent", "enabled": true,
