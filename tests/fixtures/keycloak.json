      "acme/regions": ["eu", "us"]
    }
  }],
  "GET https://kc.example.com/admin/realms/acme/users/sa-user-1/role-mappings": [200, {
    "realmMappings": [{"id": "realm-role-uuid", "name": "deployer"}],
    "clientMappings": {
      "payments-api": {"id": "payments-client-uuid", "client": "payments-api", "mappings": [{"id": "refunds-role-uuid", "name": "refunds"}]}
    }
  }],
  "GET https://kc.example.com/admin/realms/acme/users/sa-user-1/groups?briefRepresentation=true&max=500": [200, [
