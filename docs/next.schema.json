        "newer": {
          "items": {
            "$ref": "#/$defs/NewerVersion"
          },
          "maxItems": 200,
          "title": "Newer",
          "type": "array"
        }
      },
      "required": [
        "agent",
        "agent_file",
        "stack_file",
        "error_code",
        "newer"
      ],
      "title": "ProjectData",
      "type": "object"
    },
