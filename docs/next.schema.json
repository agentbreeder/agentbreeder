            }
          ]
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fix"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "const": "kubernetes",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/KubernetesData"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "fix",
        "id",
        "title",
        "required",
        "data"
      ],
      "title": "KubernetesStep",
      "type": "object"
    },
    "NewerVersion": {
      "properties": {
        "ref": {
          "maxLength": 200,
          "pattern": "^[a-z]+/[a-z0-9]([a-z0-9-]*[a-z0-9])?@[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "title": "Ref",
          "type": "string"
        },
        "latest": {
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "title": "Latest",
          "type": "string"
        },
        "file": {
          "maxLength": 4096,
          "minLength": 2,
          "pattern": "^/",
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line"
        }
      },
      "required": [
        "ref",
        "latest",
        "file",
        "line"
      ],
      "title": "NewerVersion",
      "type": "object"
    },
    "PrerequisitesData": {
      "properties": {
