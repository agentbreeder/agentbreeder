{
  "$defs": {
    "BuildData": {
      "properties": {
        "image": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image"
        },
        "build_manifest": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 2,
              "pattern": "^/",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Build Manifest"
        },
        "environment": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Environment"
        },
        "agent_yaml_current": {
          "title": "Agent Yaml Current",
          "type": "boolean"
        },
        "lock_current": {
          "title": "Lock Current",
          "type": "boolean"
        }
      },
      "required": [
        "image",
        "build_manifest",
        "environment",
        "agent_yaml_current",
        "lock_current"
      ],
      "title": "BuildData",
      "type": "object"
    },
    "BuildStep": {
      "properties": {
        "state": {
          "enum": [
            "done",
            "next",
            "blocked",
            "todo"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fix"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "const": "build",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildData"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "fix",
        "id",
        "title",
        "required",
        "data"
      ],
      "title": "BuildStep",
      "type": "object"
    },
    "Check": {
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed",
        "required",
        "message"
      ],
      "title": "Check",
      "type": "object"
    },
    "Condition": {
      "description": "A live problem (guided \u00a714.4): computed on every run, never stored, clears itself.",
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{2,39}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "enum": [
                "prerequisites",
                "project",
                "keys",
                "services",
                "build",
                "release",
                "try",
                "kubernetes"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Step"
        },
        "deployment": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deployment"
        },
        "service": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Service"
        }
      },
      "required": [
        "code",
        "message",
        "step",
        "deployment",
        "service"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Fix": {
      "description": "What fixes the step. `command` is display only: no surface runs it. The console maps\n`action` to its own fixed job; with `action: null` it shows `command` and `note`.",
      "properties": {
        "action": {
          "anyOf": [
            {
              "enum": [
                "new-agent",
                "example",
                "set-keys",
                "services-up",
                "build",
                "release",
                "invoke",
                "cluster-up",
                "promote"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Action"
        },
        "command": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Command"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Note"
        },
        "url": {
          "anyOf": [
            {
              "const": "https://aistudio.google.com/apikey",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "action",
        "command",
        "note",
        "url"
      ],
      "title": "Fix",
      "type": "object"
    },
    "KeysData": {
      "properties": {
        "required": {
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Required",
          "type": "array"
        },
        "present": {
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Present",
          "type": "array"
        },
        "stored": {
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Stored",
          "type": "array"
        },
        "missing": {
          "items": {
            "pattern": "^[A-Z_][A-Z0-9_]{0,127}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Missing",
          "type": "array"
        }
      },
      "required": [
        "required",
        "present",
        "stored",
        "missing"
      ],
      "title": "KeysData",
      "type": "object"
    },
    "KeysStep": {
      "properties": {
        "state": {
          "enum": [
            "done",
            "next",
            "blocked",
            "todo"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fix"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "const": "keys",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeysData"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "fix",
        "id",
        "title",
        "required",
        "data"
      ],
      "title": "KeysStep",
      "type": "object"
    },
    "KubernetesData": {
      "properties": {
        "cluster": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
          "title": "Cluster",
          "type": "string"
        },
        "cluster_up": {
          "title": "Cluster Up",
          "type": "boolean"
        },
        "deployment": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Deployment"
        },
        "promoted_image": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "(?:^(?:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]{1,5})?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64}$)|(?:^sha256:[a-f0-9]{64}$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Promoted Image"
        },
        "production_image": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "(?:^(?:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]{1,5})?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64}$)|(?:^sha256:[a-f0-9]{64}$)",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Production Image"
        }
      },
      "required": [
        "cluster",
        "cluster_up",
        "deployment",
        "promoted_image",
        "production_image"
      ],
      "title": "KubernetesData",
      "type": "object"
    },
    "KubernetesStep": {
      "properties": {
        "state": {
          "enum": [
            "done",
            "next",
            "blocked",
            "todo"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "anyOf": [
