        "id",
        "title",
        "required",
        "data"
      ],
      "title": "PrerequisitesStep",
      "type": "object"
    },
    "Production": {
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Id",
          "type": "string"
        },
        "image": {
          "maxLength": 512,
          "pattern": "(?:^(?:[a-z0-9]+(?:[.-][a-z0-9]+)*(?::[0-9]{1,5})?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?@sha256:[a-f0-9]{64}$)|(?:^sha256:[a-f0-9]{64}$)",
          "title": "Image",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "starting",
            "ready",
            "failed",
            "removing",
            "disabled"
          ],
          "title": "State",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "pattern": "^http://127\\.0\\.0\\.1:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Endpoint"
        },
        "manifest_current": {
          "title": "Manifest Current",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "image",
        "state",
        "endpoint",
        "manifest_current"
      ],
      "title": "Production",
      "type": "object"
    },
    "ProjectData": {
      "properties": {
        "agent": {
          "anyOf": [
